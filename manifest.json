{
  "manifest_version": 3,
  "name": "Bubblemarks Mini Sidebar",
  "version": "1.0.0",
  "description": "Opera/Chromium sidebar for Bubblemarks Mini with time, weather, and keyboard bookmark search.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Bubblemarks Mini",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "fonts/*",
        "bubbles-background.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
